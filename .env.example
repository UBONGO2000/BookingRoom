# Modele de configuration locale.
# Copier ce fichier en `.env` (ignore par Git) puis adapter les valeurs.
# Spring Boot le charge automatiquement via spring.config.import (application.properties).
# Les lignes commentees laissent les valeurs de repli du fichier commun s'appliquer.

APP_NAME=BookingRoom
#PORT=8080

# Base de donnees — obligatoire en profil `prod` (aucune valeur de repli).
DB_URL=jdbc:postgresql://localhost:5432/bookingroom
DB_USERNAME=postgres
#DB_PASSWORD=

# Comptes de demonstration — crees uniquement en profil `dev`.
#SEED_DEFAULT_USERS=true
#SEED_ADMIN_USERNAME=admin
#SEED_ADMIN_EMAIL=admin@gmail.com
#SEED_ADMIN_PASSWORD=
#SEED_USER_USERNAME=user
#SEED_USER_EMAIL=user@gmail.com
#SEED_USER_PASSWORD=

# Anti brute-force (valable dans tous les profils)
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_LOCK_DURATION_MINUTES=15
#LOGIN_RATE_LIMIT_MAX=20
#LOGIN_RATE_LIMIT_WINDOW=60

# Cookies Secure : actif par defaut en prod (HTTPS). Mettre false uniquement
# pour un acces HTTP direct de developpement.
#COOKIE_SECURE=true
